# ---------- Database (Postgres + pgvector) ----------
# Prototype: Neon via Vercel Marketplace. Production: Azure Database for PostgreSQL Flexible Server (pgvector enabled).
DATABASE_URL=postgres://user:password@host:5432/mio_kb?sslmode=require

# ---------- LLM provider ----------
# anthropic  -> api.anthropic.com (prototype)
# foundry    -> Claude via Microsoft Foundry (Azure)
# azure-openai -> GPT via Azure OpenAI (EU data residency fallback)
LLM_PROVIDER=anthropic

# Answering model and the cheap classifier model (gate 3).
# Prototype: Opus 5.5. Recommended for production: Sonnet 5.5 default + Opus escalation (see README).
ANSWER_MODEL=claude-opus-5-5
CLASSIFIER_MODEL=claude-haiku-5-5
# Thinking/effort for the answering model: low | medium | high. Low keeps latency and cost down for KB answers.
ANSWER_EFFORT=low

# Anthropic direct
ANTHROPIC_API_KEY=sk-ant-...

# Microsoft Foundry (when LLM_PROVIDER=foundry)
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=example-resource.services.ai.azure.com

# Azure OpenAI (when LLM_PROVIDER=azure-openai, or EMBEDDING_PROVIDER=azure-openai)
AZURE_OPENAI_ENDPOINT=https://example-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ---------- Embeddings ----------
# openai (prototype) | azure-openai (production, EU region). Same model -> same vectors -> no re-embedding on migration.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
# 1536 keeps us under pgvector's 2000-dim HNSW index limit. Must match schema.sql and must never change after ingest.
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=sk-...

# ---------- Gates ----------
# Gate 2: minimum cosine similarity of the best chunk before we spend any LLM tokens. Tune after looking at query_log.
RETRIEVAL_MIN_SCORE=0.30
# How many articles are passed to the answering model.
ANSWER_TOP_ARTICLES=4
# Gate 1: question length limits.
QUESTION_MIN_CHARS=8
QUESTION_MAX_CHARS=1000
# Max conversation turns (user+assistant messages) kept as context.
HISTORY_MAX_MESSAGES=6
# Max output tokens for the answer.
ANSWER_MAX_TOKENS=1000

# ---------- Salesforce (optional, for scripts/fetch-salesforce.ts) ----------
SF_INSTANCE_URL=https://mio.my.salesforce.com
SF_ACCESS_TOKEN=
SF_API_VERSION=v62.0
SF_LANGUAGE=no
